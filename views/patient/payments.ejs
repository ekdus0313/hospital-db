<%# views/patient/payments.ejs — 내 수납 내역 (화면 P-08) %>
<%- include('../layout/header', { title: '내 수납 내역', subtitle: '진료비를 진찰료·검사료·약제료·병실료로 나눠 보여 드립니다.' }) %>
<%
  const won = n => (n === null || n === undefined) ? '–' : Number(n).toLocaleString('ko-KR');
  const tag = s => ({ '완료': 'ok', '미수납': 'danger' })[s] || 'neutral';
  const unpaid = rows.filter(r => r.pay_status !== '완료').length;
%>

<dl class="stats">
  <div><dt>납부한 본인부담금</dt><dd><%= won(paidTotal) %><small>원</small></dd></div>
  <div><dt>미수납</dt><dd><%= unpaid %><small>건</small></dd></div>
  <div><dt>전체 진료</dt><dd><%= rows.length %><small>건</small></dd></div>
</dl>

<% if (rows.length === 0) { %>
  <p class="empty">아직 수납 내역이 없습니다.</p>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>진료일</th>
          <th>진료과</th>
          <th class="num">진찰료</th>
          <th class="num">검사료</th>
          <th class="num">약제료</th>
          <th class="num">병실료</th>
          <th class="num">청구금액</th>
          <th class="num">본인부담금</th>
          <th>결제</th>
          <th>상태</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="tnum"><b><%= r.treated_at %></b></td>
            <td><%= r.dept_name %></td>
            <td class="num"><%= won(r.consult_amount) %></td>
            <td class="num"><%= won(r.test_amount) %></td>
            <td class="num"><%= won(r.drug_amount) %></td>
            <td class="num"><%= won(r.room_amount) %></td>
            <td class="num"><%= won(r.total_amount) %></td>
            <td class="num"><b><%= won(r.patient_amount) %></b></td>
            <td class="muted"><%= r.pay_method ? r.pay_method + ' · ' + r.paid_at : '–' %></td>
            <td><span class="tag tag--<%= tag(r.pay_status) %>"><%= r.pay_status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="note">본인부담금은 청구금액에 보험 유형별 본인부담률을 곱한 금액입니다(10원 미만 버림). 입원 진료비는 퇴원할 때 병실료까지 합쳐 냅니다.</p>
<% } %>

<%- include('../layout/footer') %>
