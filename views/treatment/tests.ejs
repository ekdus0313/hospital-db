<%- include('../layout/header', { title: '검사 목록' }) %>

  <h1>검사 목록</h1>

  <% if (rows.length === 0) { %>
    <p>검사 내역이 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>상태</th>
          <th>검사번호</th>
          <th>환자</th>
          <th>검사명</th>
          <th>분류</th>
          <th>검사일시</th>
          <th>결과</th>
          <th>검사비</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.test_status %></td>
            <td><%= r.test_no %></td>
            <td><%= r.patient_name %></td>
            <td><%= r.test_name %></td>
            <td><%= r.test_category %></td>
            <td><%= r.tested_at === null ? '-' : r.tested_at %></td>
            <td><%= r.test_result === null ? '-' : r.test_result %></td>
            <td><%= r.applied_price.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../layout/footer') %>
