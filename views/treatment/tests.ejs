<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>검사 목록</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- 공통 레이아웃이 올라오면 머리말·메뉴를 여기에 넣는다 -->

  <h1>검사 목록</h1>

  <% if (rows.length === 0) { %>
    <p>검사 내역이 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>상태</th>
          <th>검사번호</th>
          <th>환자</th>
          <th>검사명</th>
          <th>분류</th>
          <th>검사일시</th>
          <th>결과</th>
          <th>검사비</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.test_status %></td>
            <td><%= r.test_no %></td>
            <td><%= r.patient_name %></td>
            <td><%= r.test_name %></td>
            <td><%= r.test_category %></td>
            <td><%= r.tested_at === null ? '-' : r.tested_at %></td>
            <td><%= r.test_result === null ? '-' : r.test_result %></td>
            <td><%= r.applied_price.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>