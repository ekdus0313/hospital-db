<%- include('../layout/header', { title: '대기 환자 목록' }) %>

  <form method="get" action="/treatment/doctor" style="margin: 14px 0;">
    <label for="date">접수일자 </label>
    <input type="date" id="date" name="date" value="<%= date %>">
    <button type="submit">조회</button>
    <% if (date !== today) { %>
      <a href="/treatment/doctor" style="margin-left:10px;">오늘로</a>
    <% } %>
  </form>

  <% if (rows.length === 0) { %>
    <p><%= date %> 에 접수된 환자가 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>대기번호</th>
          <th>접수시각</th>
          <th>환자번호</th>
          <th>환자</th>
          <th>진료과</th>
          <th>담당의사</th>
          <th>진료</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.waiting_no %></td>
            <td><%= r.reception_at %></td>
            <td><%= r.patient_no %></td>
            <td><%= r.patient_name %></td>
            <td><%= r.dept_name %></td>
            <td><%= r.employee_name %></td>
            <td>
              <a href="/treatment/record/new?reservation=<%= r.reservation_no %>">진료 시작</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../layout/footer') %>