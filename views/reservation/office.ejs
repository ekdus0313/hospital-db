<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>예약 목록</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- 공통 레이아웃이 올라오면 머리말·메뉴를 여기에 넣는다 -->

  <h1>예약 목록</h1>

  <% if (rows.length === 0) { %>
    <p>예약 내역이 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>예약번호</th>
          <th>예약일시</th>
          <th>환자</th>
          <th>진료과</th>
          <th>담당의사</th>
          <th>예약구분</th>
          <th>상태</th>
          <th>대기번호</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.reservation_no %></td>
            <td><%= r.reserved_at %></td>
            <td><%= r.patient_name %></td>
            <td><%= r.dept_name %></td>
            <td><%= r.employee_name %></td>
            <td><%= r.reservation_type %></td>
            <td><%= r.reservation_status %></td>
            <td><%= r.waiting_no === null ? '-' : r.waiting_no %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
