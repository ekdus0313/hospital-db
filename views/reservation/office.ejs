<%- include('../layout/header', { title: '예약 목록' }) %>

  <% if (rows.length === 0) { %>
    <p>예약 내역이 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>예약번호</th>
          <th>예약일시</th>
          <th>환자</th>
          <th>진료과</th>
          <th>담당의사</th>
          <th>예약구분</th>
          <th>상태</th>
          <th>대기번호</th>
          <th>처리</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.reservation_no %></td>
            <td><%= r.reserved_at %></td>
            <td><%= r.patient_name %></td>
            <td><%= r.dept_name %></td>
            <td><%= r.employee_name %></td>
            <td><%= r.reservation_type %></td>
            <td><%= r.reservation_status %></td>
            <td><%= r.waiting_no === null ? '-' : r.waiting_no %></td>
            <td>
              <% if (r.reservation_status === '예약') { %>
                <form class="inline-form" method="post" action="/reservation/<%= r.reservation_no %>/reception">
                  <button type="submit" class="btn btn--primary btn--sm">접수</button>
                </form>
                <form class="inline-form" method="post" action="/reservation/<%= r.reservation_no %>/cancel">
                  <button type="submit" class="btn btn--secondary btn--sm">취소</button>
                </form>
              <% } else { %>
                -
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../layout/footer') %>
