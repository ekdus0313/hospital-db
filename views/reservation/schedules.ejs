<%- include('../layout/header', { title: '진료 일정', subtitle: '휴진 처리하면 그 일정의 예약이 모두 취소됩니다. 접수된 환자가 있는 일정은 휴진할 수 없습니다.' }) %>
<% const isOffice = user.role === '원무'; %>

<form class="form" method="POST" action="/reservation/schedules">
  <fieldset class="formsec">
    <legend class="formsec__head"><b>진료일정 등록</b>
      <small>같은 의사의 같은 날 같은 시각은 등록할 수 없습니다.</small></legend>
    <div class="formsec__body">
      <label class="field"><span>일정번호 <span class="req">*</span></span>
        <input name="schedule_no" maxlength="20" placeholder="3001" required></label>
      <label class="field"><span>담당 의사 <span class="req">*</span></span>
        <select name="employee_no" required>
          <option value="">고르세요</option>
          <% doctors.forEach(function (d) { %>
            <option value="<%= d.employee_no %>">
              <%= d.dept_name %> · <%= d.employee_name %></option>
          <% }) %>
        </select></label>
      <label class="field"><span>진료일자 <span class="req">*</span></span>
        <input name="schedule_date" type="date" required></label>
      <label class="field"><span>시작시각 <span class="req">*</span></span>
        <input name="start_time" type="time" value="09:00" required></label>
      <label class="field"><span>종료시각 <span class="req">*</span></span>
        <input name="end_time" type="time" value="12:00" required></label>
      <label class="field"><span>정원 <span class="req">*</span></span>
        <input name="capacity" type="number" min="1" value="12" required></label>
    </div>
  </fieldset>
  <div class="form__actions">
    <button type="submit" class="btn btn--primary">등록</button></div>
</form>

  <% if (rows.length === 0) { %>
    <p>오늘 이후 진료 일정이 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>일정번호</th>
          <th>진료일자</th>
          <th>시간</th>
          <th>진료과</th>
          <th>담당의사</th>
          <th>정원</th>
          <th>예약</th>
          <th>접수</th>
          <th>운영</th>
          <th>처리</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr class="<%= r.operation_status === '휴진' ? 'row-muted' : '' %>">
            <td><%= r.schedule_no %></td>
            <td><%= r.schedule_date %></td>
            <td><%= r.start_time %>~<%= r.end_time %></td>
            <td><%= r.dept_name %></td>
            <td><%= r.employee_name %></td>
            <td><%= r.capacity %></td>
            <td><%= r.reserved_count %></td>
            <td><%= r.received_count %></td>
            <td><%= r.operation_status %></td>
            <td>
              <form class="inline-form" method="POST"
                    action="/reservation/schedules/<%= r.schedule_no %>/edit">
                <input name="start_time" type="time" value="<%= r.start_time %>" required>
                <input name="end_time"   type="time" value="<%= r.end_time %>" required>
                <input name="capacity"   type="number" min="1" value="<%= r.capacity %>"
                       style="width:60px" required>
                <button type="submit" class="btn btn--sm">수정</button>
              </form>
              <%# 휴진은 원무만 (R-0031) %>
              <% if (isOffice && r.operation_status === '정상' && r.received_count == 0) { %>
                <form class="inline-form" method="post" action="/reservation/schedules/<%= r.schedule_no %>/close"
                      onsubmit="return confirm('휴진 처리하면 예약 <%= r.reserved_count %>건이 모두 취소됩니다. 진행할까요?')">
                  <button type="submit" class="btn btn--secondary btn--sm">휴진</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../layout/footer') %>
