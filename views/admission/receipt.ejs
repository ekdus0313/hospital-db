<%# views/admission/receipt.ejs — 진료비 영수증 (조원4). payment 저장값만 표시 %>
<%- include('../layout/header', { title: '진료비 영수증', subtitle: '수납번호 ' + r.payment_no + ' · ' + r.patient_name }) %>
<%
  const won = n => Number(n || 0).toLocaleString('ko-KR') + '원';
  const insurerShare = Number(r.total_amount) - Number(r.patient_amount);   // 공단부담금 (저장값끼리 계산)
  const backHref = (typeof user !== 'undefined' && user && user.role === 'patient') ? '/patient/payments' : '/admission/payments';
%>

<style>
  .receipt { max-width: 720px; }
  .receipt table { width: 100%; margin-bottom: 24px; }
  .receipt th { width: 34%; text-align: left; }
  .receipt td.num { text-align: right; }
  .receipt .total th, .receipt .total td { font-weight: 700; }
  @media print {
    .topbar, .mainnav, .hero, .footer, .no-print { display: none !important; }
    .receipt { max-width: none; }
  }
</style>

<% if (msg) { %>
  <div class="alert no-print" role="status"><%= msg %></div>
<% } %>

<div class="receipt">
  <h3>진료 정보</h3>
  <table>
    <tbody>
      <tr><th>수납번호</th><td><%= r.payment_no %></td></tr>
      <tr><th>환자</th><td><%= r.patient_name %> (<%= r.patient_no %>)</td></tr>
      <tr><th>보험 유형</th><td><%= r.insurance_name %></td></tr>
      <tr><th>진료번호</th><td><%= r.medical_record_no %></td></tr>
      <tr><th>진료일시</th><td><%= r.treated_at %></td></tr>
      <tr><th>진료과 · 담당의</th><td><%= r.dept_name %> · <%= r.employee_name %></td></tr>
      <% if (r.admission_no) { %>
        <tr><th>입원</th><td><%= r.admission_no %> (<%= r.admit_at %> ~ <%= r.discharge_at || '' %>)</td></tr>
      <% } %>
    </tbody>
  </table>

  <h3>진료비 내역</h3>
  <table>
    <tbody>
      <tr><th>진찰료</th><td class="num"><%= won(r.consult_amount) %></td></tr>
      <tr><th>검사료</th><td class="num"><%= won(r.test_amount) %></td></tr>
      <tr><th>약제료</th><td class="num"><%= won(r.drug_amount) %></td></tr>
      <tr><th>병실료</th><td class="num"><%= won(r.room_amount) %></td></tr>
      <tr class="total"><th>청구금액</th><td class="num"><%= won(r.total_amount) %></td></tr>
      <tr><th>공단부담금</th><td class="num"><%= won(insurerShare) %></td></tr>
      <tr class="total"><th>본인부담금 (납부액)</th><td class="num"><%= won(r.patient_amount) %></td></tr>
    </tbody>
  </table>

  <h3>결제</h3>
  <table>
    <tbody>
      <tr><th>결제수단</th><td><%= r.pay_method %></td></tr>
      <tr><th>수납일시</th><td><%= r.paid_at %></td></tr>
      <tr><th>상태</th><td><%= r.pay_status %></td></tr>
    </tbody>
  </table>

  <div class="form__actions no-print">
    <a class="btn btn--secondary" href="<%= backHref %>">목록으로</a>
    <button type="button" class="btn btn--primary" onclick="window.print()">인쇄</button>
  </div>
</div>

<%- include('../layout/footer') %>
