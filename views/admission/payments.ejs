<%- include('../layout/header', { title: '수납 대상 목록', subtitle: '아직 수납하지 않은 진료입니다. 금액은 수납 버튼을 누르면 지금 기준으로 다시 계산됩니다.' }) %>

  <% if (typeof msg !== 'undefined' && msg) { %>
    <div class="alert" role="status"><%= msg %></div>
  <% } %>
  <% if (typeof err !== 'undefined' && err) { %>
    <div class="alert alert--danger" role="alert"><%= err %></div>
  <% } %>

  <% if (rows.length === 0) { %>
    <p>수납할 진료가 없습니다.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>진료번호</th>
          <th>진료일시</th>
          <th>환자</th>
          <th>진료과</th>
          <th>담당의사</th>
          <th>청구금액</th>
          <th>본인부담금</th>
          <th>수납상태</th>
          <th>비고</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.medical_record_no %></td>
            <td><%= r.treated_at %></td>
            <td><%= r.patient_name %></td>
            <td><%= r.dept_name %></td>
            <td><%= r.employee_name %></td>
            <td><%= r.total_amount === null ? '-' : Number(r.total_amount).toLocaleString() + '원' %></td>
            <td><%= r.patient_amount === null ? '-' : Number(r.patient_amount).toLocaleString() + '원' %></td>
            <td><%= r.pay_status %></td>
            <td>
              <% if (r.adm_status === '입원중') { %>
                입원중 — 퇴원 후 정산
              <% } else if (r.payment_no === null) { %>
                진료비 계산 전
              <% } else { %>
                -
              <% } %>
            </td>
            <td>
              <% if (user && user.role === '원무' && r.adm_status !== '입원중') { %>
                <a class="btn btn--primary btn--sm" href="/admission/payments/<%= r.medical_record_no %>">수납</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../layout/footer') %>
