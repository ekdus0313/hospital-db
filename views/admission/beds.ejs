<%- include('../layout/header', { title: '병상 현황' }) %>

  <h1>병상 현황</h1>

  <% if (rooms.length === 0) { %>
    <p>등록된 병실이 없습니다.</p>
  <% } else { %>
    <p>전체 <%= total %>개 중 사용중 <%= used %>개 · 가동률 <%= rate %>%</p>

    <h2>병실별</h2>
    <table>
      <thead>
        <tr>
          <th>병동</th>
          <th>병실</th>
          <th>유형</th>
          <th>1일 병실료</th>
          <th>전체 병상</th>
          <th>사용중</th>
          <th>남은 병상</th>
        </tr>
      </thead>
      <tbody>
        <% rooms.forEach(function (r) { %>
          <tr>
            <td><%= r.ward %></td>
            <td><%= r.room_no %></td>
            <td><%= r.room_type %></td>
            <td><%= Number(r.daily_fee).toLocaleString() %>원</td>
            <td><%= r.total_beds %></td>
            <td><%= r.used_beds %></td>
            <td><%= r.total_beds - r.used_beds === 0 ? '만실' : r.total_beds - r.used_beds %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <h2>병상별</h2>
    <table>
      <thead>
        <tr>
          <th>병상</th>
          <th>병실</th>
          <th>유형</th>
          <th>상태</th>
          <th>입원 환자</th>
          <th>입원일</th>
        </tr>
      </thead>
      <tbody>
        <% beds.forEach(function (b) { %>
          <tr>
            <td><%= b.bed_no %></td>
            <td><%= b.room_no %></td>
            <td><%= b.room_type %></td>
            <td><%= b.bed_status %></td>
            <td><%= b.patient_name || '-' %></td>
            <td><%= b.admit_at || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<%- include('../layout/footer') %>
