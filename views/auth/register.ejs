
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>환자 회원가입</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #f3f6fb;
      font-family: Arial, sans-serif;
      padding: 40px 16px;
    }

    .container {
      max-width: 580px;
      margin: auto;
      background: white;
      padding: 36px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,.08);
    }

    h2 {
      text-align: center;
      color: #234b7a;
    }

    label {
      display: block;
      margin: 16px 0 6px;
      font-weight: bold;
    }

    input, select {
      width: 100%;
      padding: 11px;
      border: 1px solid #ccd5e0;
      border-radius: 6px;
      font-size: 15px;
    }

    .row {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .row input {
      flex: 1;
      min-width: 0;
    }

    .error {
      padding: 12px;
      margin: 18px 0;
      background: #fee2e2;
      color: #b91c1c;
      border-radius: 6px;
    }

    .notice {
      color: #64748b;
      font-size: 12px;
      margin-top: 5px;
    }

    button {
      width: 100%;
      padding: 13px;
      margin-top: 26px;
      border: none;
      border-radius: 6px;
      background: #2563eb;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }

    .bottom {
      text-align: center;
      margin-top: 20px;
    }

    a {
      color: #2563eb;
      text-decoration: none;
    }
  </style>
</head>

<body>
<div class="container">
  <h2>환자 회원가입</h2>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <form action="/auth/register" method="POST">

    <label>이름</label>
    <input type="text" name="patient_name"
      maxlength="50"
      value="<%= old.patient_name || '' %>" required>

    <label>아이디</label>
    <input type="text" name="username"
      minlength="4" maxlength="50"
      pattern="[a-zA-Z0-9_]+"
      value="<%= old.username || '' %>"
      autocomplete="username" required>

    <label>비밀번호</label>
    <input type="password" name="password"
      minlength="8" autocomplete="new-password" required>
    <div class="notice">8자 이상 입력하세요.</div>

    <label>주민등록번호</label>
    <div class="row">
      <input type="text" name="ssn1"
        placeholder="앞 6자리"
        maxlength="6" pattern="[0-9]{6}"
        autocomplete="off" required>

      <span>-</span>

      <input type="password" name="ssn2"
        placeholder="뒤 7자리"
        maxlength="7" pattern="[0-9]{7}"
        autocomplete="off" required>
    </div>
    <div class="notice">
      주민등록번호는 암호화하여 저장합니다.
    </div>

    <label>생년월일</label>
    <input type="date" name="birth_date"
      value="<%= old.birth_date || '' %>" required>

    <label>성별</label>
    <select name="gender" required>
      <option value="">선택하세요</option>
      <option value="남" <%= old.gender === '남' ? 'selected' : '' %>>남</option>
      <option value="여" <%= old.gender === '여' ? 'selected' : '' %>>여</option>
      <option value="기타" <%= old.gender === '기타' ? 'selected' : '' %>>기타</option>
    </select>

    <label>전화번호</label>
    <input type="tel" name="phone"
      maxlength="20" pattern="[0-9-]{9,20}"
      placeholder="010-1234-5678"
      value="<%= old.phone || '' %>" required>

    <label>우편번호</label>
    <input type="text" name="zip_code"
      maxlength="5" pattern="[0-9]{5}"
      value="<%= old.zip_code || '' %>" required>

    <label>기본주소</label>
    <input type="text" name="address1"
      maxlength="255"
      value="<%= old.address1 || '' %>" required>

    <label>상세주소</label>
    <input type="text" name="address2"
      maxlength="255"
      value="<%= old.address2 || '' %>">

    <label>참고주소</label>
    <input type="text" name="address3"
      maxlength="255"
      value="<%= old.address3 || '' %>">

    <label>보험코드</label>
    <select name="insurance_code" required>
      <option value="">보험코드를 선택하세요</option>

      <% insuranceCodes.forEach(function(item) { %>
        <option value="<%= item.insurance_code %>"
          <%= old.insurance_code === item.insurance_code ? 'selected' : '' %>>
          <%= item.insurance_code %>
        </option>
      <% }); %>
    </select>

    <button type="submit">회원가입</button>
  </form>

  <div class="bottom">
    이미 계정이 있으신가요?
    <a href="/auth/login">로그인</a>
  </div>
</div>
</body>
</html>
