<%# views/auth/register.ejs — 환자 회원가입 (화면 C-03) %>
<%- include('../layout/header', {
  title: '환자 회원가입',
  subtitle: '가입하면 온라인 진료 예약과 진료·수납 내역 조회를 이용할 수 있습니다.',
  variant: 'auth'
}) %>

<div class="sheet-head">
  <p class="muted"><span class="req">*</span> 표시는 필수 입력 항목입니다.</p>
  <span class="muted">이미 계정이 있으신가요? <a href="/auth/login">로그인</a></span>
</div>

<% if (error) { %>
  <div class="alert alert--danger" role="alert"><%= error %></div>
<% } %>

<form action="/auth/register" method="POST" class="form">

  <fieldset class="formsec">
    <legend class="formsec__head">
      <span class="formsec__no">01</span>
      <b>계정 정보</b>
      <small>로그인에 사용할 아이디와 비밀번호를 정해 주세요.</small>
    </legend>
    <div class="formsec__body">
      <div class="field field--full">
        <label for="patient_name">이름 <span class="req">*</span></label>
        <input type="text" id="patient_name" name="patient_name"
          maxlength="50"
          value="<%= old.patient_name || '' %>" required>
      </div>

      <div class="field">
        <label for="username">아이디 <span class="req">*</span></label>
        <input type="text" id="username" name="username"
          minlength="4" maxlength="50"
          pattern="[a-zA-Z0-9_]+"
          value="<%= old.username || '' %>"
          autocomplete="username" required>
        <p class="hint">영문, 숫자, 밑줄(_)로 4자 이상</p>
      </div>

      <div class="field">
        <label for="password">비밀번호 <span class="req">*</span></label>
        <input type="password" id="password" name="password"
          minlength="8" autocomplete="new-password" required>
        <p class="hint">8자 이상 입력해 주세요</p>
      </div>
    </div>
  </fieldset>

  <fieldset class="formsec">
    <legend class="formsec__head">
      <span class="formsec__no">02</span>
      <b>본인 확인</b>
      <small>주민등록번호는 암호화되어 저장됩니다.</small>
    </legend>
    <div class="formsec__body">
      <div class="field field--full">
        <label for="ssn1">주민등록번호 <span class="req">*</span></label>
        <div class="ssn">
          <input type="text" id="ssn1" name="ssn1"
            placeholder="앞 6자리" inputmode="numeric"
            maxlength="6" pattern="[0-9]{6}"
            autocomplete="off" required>
          <span aria-hidden="true">–</span>
          <input type="password" name="ssn2" aria-label="주민등록번호 뒤 7자리"
            placeholder="뒤 7자리" inputmode="numeric"
            maxlength="7" pattern="[0-9]{7}"
            autocomplete="off" required>
        </div>
      </div>

      <div class="field">
        <label for="birth_date">생년월일 <span class="req">*</span></label>
        <input type="date" id="birth_date" name="birth_date"
          value="<%= old.birth_date || '' %>" required>
      </div>

      <div class="field">
        <label for="gender">성별 <span class="req">*</span></label>
        <select id="gender" name="gender" required>
          <option value="">선택해 주세요</option>
          <option value="남" <%= old.gender === '남' ? 'selected' : '' %>>남</option>
          <option value="여" <%= old.gender === '여' ? 'selected' : '' %>>여</option>
          <option value="기타" <%= old.gender === '기타' ? 'selected' : '' %>>기타</option>
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset class="formsec">
    <legend class="formsec__head">
      <span class="formsec__no">03</span>
      <b>연락처·주소</b>
      <small>병원에서 연락드릴 때 사용합니다.</small>
    </legend>
    <div class="formsec__body">
      <div class="field">
        <label for="phone">전화번호 <span class="req">*</span></label>
        <input type="tel" id="phone" name="phone"
          maxlength="20" pattern="[0-9-]{9,20}"
          placeholder="010-1234-5678"
          value="<%= old.phone || '' %>" required>
      </div>

      <div class="field">
        <label for="zip_code">우편번호 <span class="req">*</span></label>
        <input type="text" id="zip_code" name="zip_code" inputmode="numeric"
          maxlength="5" pattern="[0-9]{5}"
          placeholder="숫자 5자리"
          value="<%= old.zip_code || '' %>" required>
      </div>

      <div class="field field--full">
        <label for="address1">기본주소 <span class="req">*</span></label>
        <input type="text" id="address1" name="address1"
          maxlength="255"
          value="<%= old.address1 || '' %>" required>
      </div>

      <div class="field">
        <label for="address2">상세주소</label>
        <input type="text" id="address2" name="address2"
          maxlength="255"
          value="<%= old.address2 || '' %>">
      </div>

      <div class="field">
        <label for="address3">참고항목</label>
        <input type="text" id="address3" name="address3"
          maxlength="255"
          placeholder="예: (성북동, 한성아파트)"
          value="<%= old.address3 || '' %>">
      </div>
    </div>
  </fieldset>

  <fieldset class="formsec">
    <legend class="formsec__head">
      <span class="formsec__no">04</span>
      <b>보험</b>
      <small>보험 유형에 따라 진료비 본인부담금이 달라집니다.</small>
    </legend>
    <div class="formsec__body">
      <div class="field field--full">
        <label for="insurance_code">보험 유형 <span class="req">*</span></label>
        <select id="insurance_code" name="insurance_code" required>
          <option value="">보험 유형을 선택해 주세요</option>
          <% insuranceCodes.forEach(function(item) { %>
            <option value="<%= item.insurance_code %>"
              <%= old.insurance_code === item.insurance_code ? 'selected' : '' %>>
              <%= item.insurance_name
                    ? item.insurance_name + ' (본인부담 ' + item.copay_rate + '%)'
                    : item.insurance_code %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>
  </fieldset>

  <div class="form__actions">
    <a class="btn btn--secondary" href="/auth/login">취소</a>
    <button type="submit" class="btn btn--primary">가입하기</button>
  </div>
</form>

<%- include('../layout/footer') %>
