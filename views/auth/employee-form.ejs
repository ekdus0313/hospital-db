
<%- include('../layout/header', {
    title: mode === 'new' ? '직원 등록' : '직원 정보 수정',
    subtitle: '관리자 · 직원 정보 관리'
}) %>

<section class="formsec">

    <div class="formsec__body">

        <form method="POST"
              action="<%= mode === 'new'
                  ? '/auth/employees/new'
                  : '/auth/employees/' + encodeURIComponent(employee.employee_no) + '/edit' %>">

            <div class="field field--full">
                <label>사번</label>
                <input type="text"
                       name="employee_no"
                       maxlength="20"
                       value="<%= employee ? employee.employee_no : '' %>"
                       <%= mode === 'edit' ? 'readonly' : '' %>
                       required>
            </div>

            <div class="field field--full">
                <label>직원 이름</label>
                <input type="text"
                       name="employee_name"
                       maxlength="50"
                       value="<%= employee ? employee.employee_name : '' %>"
                       required>
            </div>

            <div class="field field--full">
                <label>직종</label>

                <select name="job_type" required>
                    <option value="">직종 선택</option>

                    <% ['관리자', '의사', '검사실', '원무'].forEach(job => { %>

                        <option value="<%= job %>"
                            <%= employee && employee.job_type === job ? 'selected' : '' %>>
                            <%= job %>
                        </option>

                    <% }); %>
                </select>
            </div>

            <div class="field field--full">
                <label>소속 진료과</label>

                <select name="dept_code" required>
                    <option value="">진료과 선택</option>

                    <% departments.forEach(dept => { %>

                        <option value="<%= dept.dept_code %>"
                            <%= employee && employee.dept_code === dept.dept_code ? 'selected' : '' %>>
                            <%= dept.dept_name %>
                        </option>

                    <% }); %>
                </select>
            </div>

            <div class="field field--full">
            <label>면허번호</label>

            <input type="text"
                name="license_no"
                maxlength="50"
                placeholder="예: 의사-123456"
                value="<%= employee ? employee.license_no || '' : '' %>">

            <small>
                의사: 의사-123456 / 검사실: 임상병리사-12345
                (면허가 없는 직원은 공란)
            </small>
            </div>

            <div class="field field--full">
                <label>아이디</label>

                <input type="text"
                       name="username"
                       maxlength="50"
                       value="<%= employee ? employee.username : '' %>"
                       required>
            </div>

            <% if (mode === 'new') { %>

                <div class="field field--full">
                    <label>비밀번호</label>

                    <input type="password"
                           name="password"
                           minlength="8"
                           autocomplete="new-password"
                           placeholder="8자 이상 입력"
                           required>
                </div>

            <% } %>

            <div style="margin-top: 20px;">

                <button type="submit" class="btn">
                    <%= mode === 'new' ? '등록' : '수정 저장' %>
                </button>

                <a href="/auth/employees" class="btn">
                    목록으로
                </a>

            </div>

        </form>

    </div>

</section>

<%- include('../layout/footer') %>
