<%# views/auth/login.ejs — 로그인 (화면 C-02) %>
<%- include('../layout/header', {
  title: '로그인',
  subtitle: '환자와 병원 직원 모두 이 화면에서 로그인합니다.',
  variant: 'auth'
}) %>

<div class="auth">
  <section class="auth__main">
    <h2 class="auth__title">아이디로 로그인</h2>

    <% if (error) { %>
      <div class="alert alert--danger" role="alert"><%= error %></div>
    <% } %>

    <form action="/auth/login" method="POST" class="form">
      <div class="field">
        <label for="username">아이디</label>
        <input
          type="text"
          id="username"
          name="username"
          required
          autofocus
          autocomplete="username"
        >
      </div>

      <div class="field">
        <label for="password">비밀번호</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="btn btn--primary btn--block">로그인</button>
    </form>
  </section>

  <aside class="auth__aside">
    <span class="eyebrow">처음 오셨나요?</span>
    <h2>환자 회원가입</h2>
    <p class="muted">회원가입하면 병원에 오지 않고도<br>아래 서비스를 이용할 수 있습니다.</p>
    <ul class="checklist">
      <li>진료 예약</li>
      <li>예약 내역과 대기번호 확인</li>
      <li>진료 기록과 검사 결과 조회</li>
      <li>진료비 수납 내역 확인</li>
    </ul>
    <a class="btn btn--secondary btn--block" href="/auth/register">회원가입</a>
    <p class="auth__staff">직원 계정은 병원 관리자에게 요청해 주세요.</p>
  </aside>
</div>

<%- include('../layout/footer') %>
