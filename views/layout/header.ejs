<%#
  =====================================================
  views/layout/header.ejs — 공통 머리글 + 메뉴 + 페이지 머리 띠 (조원5)

  화면 맨 위 : include('../layout/header', { title: '화면 제목', subtitle: '한 줄 설명(선택)' })
  화면 맨 아래: include('../layout/footer')
  (출력 태그로 감싸서 쓴다. 예시는 views/patient/reservations.ejs)

  - title    : 남색 띠에 크게 나오는 제목 (브라우저 탭 제목에도 쓰임)
  - subtitle : 제목 아래 한 줄 설명 (없어도 됨)
  - variant  : 'home' 이면 메인 화면용 큰 머리 띠, 'auth' 면 로그인·회원가입용 좁은 화면

  user, menu, roleLabel, currentPath 는 app.js 공통 미들웨어가 넘겨 준다.
  =====================================================
%>
<%
  const _user     = typeof user !== 'undefined' ? user : null;
  const _menu     = typeof menu !== 'undefined' ? menu : [];
  const _role     = typeof roleLabel !== 'undefined' ? roleLabel : '';
  const _path     = typeof currentPath !== 'undefined' ? currentPath : '';
  const _title    = typeof title !== 'undefined' && title ? title : '';
  const _subtitle = typeof subtitle !== 'undefined' && subtitle ? subtitle : '';
  const _variant  = typeof variant !== 'undefined' ? variant : '';
  const _heroHtml = typeof heroActions !== 'undefined' ? heroActions : '';

  // 제목에 줄바꿈(\n)을 쓸 수 있게 — 글자는 먼저 안전하게 바꾼다(HTML 주입 방지)
  const _esc = v => String(v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  // 머리 띠 위 작은 머리글
  const _eyebrow = !_user ? 'Hospital Information System'
                 : _user.role === 'patient' ? '환자 서비스 · Patient'
                 : _role + ' 업무 · Staff';

  // 오늘 날짜
  const _d = new Date();
  const _days = ['일', '월', '화', '수', '목', '금', '토'];
  const _pad = n => String(n).padStart(2, '0');
  const _today = `${_d.getFullYear()}. ${_pad(_d.getMonth() + 1)}. ${_pad(_d.getDate())} (${_days[_d.getDay()]})`;
%>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= _title && _variant !== 'home' ? _title + ' | ' : '' %>병원 예약·진료 관리 시스템</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="wrap">
      <a class="logo" href="/">
        <span class="logo__mark" aria-hidden="true"><i></i></span>
        <span class="logo__text">
          <span class="logo__name">병원 예약·진료 관리</span>
          <span class="logo__en">HOSPITAL CARE SYSTEM</span>
        </span>
      </a>

      <div class="topbar__right">
        <span class="topbar__date"><%= _today %></span>
        <% if (_user) { %>
          <span class="topbar__user">
            <b><%= _user.name %></b><%= _user.role === 'patient' ? ' 님' : '' %>
            <small><%= _user.role === 'patient' ? _user.patient_no : _role %></small>
          </span>
          <form action="/auth/logout" method="POST" class="inline-form">
            <button type="submit" class="linkbtn">로그아웃</button>
          </form>
        <% } else { %>
          <a href="/auth/login">로그인</a>
          <a href="/auth/register">회원가입</a>
        <% } %>
      </div>
    </div>
  </header>

  <% if (_menu.length > 0) { %>
    <nav class="mainnav" aria-label="주 메뉴">
      <div class="wrap">
        <a href="/" class="<%= _path === '/' ? 'active' : '' %>">홈</a>
        <% _menu.forEach(function (m) { %>
          <a href="<%= m.href %>" class="<%= _path === m.href ? 'active' : '' %>"><%= m.label %></a>
        <% }) %>
      </div>
    </nav>
  <% } %>

  <section class="hero <%= _variant ? 'hero--' + _variant : '' %>">
    <div class="wrap">
      <span class="eyebrow"><%= _eyebrow %></span>
      <h1><%- _esc(_title).replace(/\n/g, '<br>') %></h1>
      <% if (_subtitle) { %><p class="hero__sub"><%= _subtitle %></p><% } %>
      <% if (_heroHtml) { %><div class="hero__actions"><%- _heroHtml %></div><% } %>
    </div>
  </section>

  <main class="content wrap <%= _variant ? 'content--' + _variant : '' %>">
    <div class="sheet">
